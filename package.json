{
  "name": "all-in-one",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@aio/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "npm run db:push --workspace=@aio/db",
    "db:studio": "npm run db:studio --workspace=@aio/db",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8"
}
