# Supabase gives you all four of these under Project Settings.

# Pooled connection — what the app uses at runtime.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — only used when changing the schema (prisma migrate).
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Safe to expose to the browser and the mobile app.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Server only. This key bypasses every access rule, so it must never be
# prefixed with NEXT_PUBLIC_ and never reach the browser.
SUPABASE_SERVICE_ROLE_KEY="..."

# Public site URL, used for the social-card image in <head>. Vercel fills this
# in automatically on a deploy; set it once you have a real domain.
# NEXT_PUBLIC_SITE_URL="https://allinone.example"
